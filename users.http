@baseUrl = http://localhost:8080
@userId = 1
@userEmail = api-user-{{$timestamp}}@example.com

### Create user (201); generated ID is reused by later requests
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "API User",
  "email": "{{userEmail}}",
  "password": "change-me-123"
}
> {% client.global.set("userId", response.body.id); %}

### List users (200)
GET {{baseUrl}}/api/users

### Read user (200)
GET {{baseUrl}}/api/users/{{userId}}

### Duplicate email (409, DUPLICATE_USER_EMAIL)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Another User",
  "email": "{{userEmail}}",
  "password": "change-me-123"
}

### Invalid name, email, and password (400, INVALID_REQUEST)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": " ",
  "email": "not-an-email",
  "password": "short"
}

### Replace user name and email (200)
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Updated API User",
  "email": "updated-{{$timestamp}}@example.com"
}

### Required field missing (400, INVALID_REQUEST)
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Updated API User"
}

### Read a missing user (404, USER_NOT_FOUND)
GET {{baseUrl}}/api/users/999999999

### Delete user (204)
DELETE {{baseUrl}}/api/users/{{userId}}

### Read deleted user (404, USER_NOT_FOUND)
GET {{baseUrl}}/api/users/{{userId}}
