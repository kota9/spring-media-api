@baseUrl = http://localhost:8080

### Run all requests in this file from top to bottom to create prerequisite data and test comments.
### Create category for the content (201); stores generated ID
POST {{baseUrl}}/api/categories
Content-Type: application/json

{"name":"comment-category-{{$timestamp}}","description":"Category for comment tests"}
> {% client.global.set("categoryId", response.body.id); %}

### Create author user (201); stores generated ID
POST {{baseUrl}}/api/users
Content-Type: application/json

{"name":"Comment User","email":"comment-{{$timestamp}}@example.com","password":"change-me-123"}
> {% client.global.set("userId", response.body.id); %}

### Create content for comments (201); stores generated ID
POST {{baseUrl}}/api/contents
Content-Type: application/json

{"title":"Comment test content","description":"Content for comment requests","authorId":{{userId}},"categoryId":{{categoryId}}}
> {% client.global.set("contentId", response.body.id); %}

### Create comment (201); generated user and content IDs are used
POST {{baseUrl}}/api/contents/{{contentId}}/comments
Content-Type: application/json

{"userId":{{userId}},"body":"First comment"}
> {% client.global.set("commentId", response.body.id); %}

### List comments for content (200)
GET {{baseUrl}}/api/contents/{{contentId}}/comments

### Read comment (200)
GET {{baseUrl}}/api/comments/{{commentId}}

### Update comment body (200)
PUT {{baseUrl}}/api/comments/{{commentId}}
Content-Type: application/json

{"body":"Updated comment"}

### Blank comment body (400, INVALID_REQUEST)
PUT {{baseUrl}}/api/comments/{{commentId}}
Content-Type: application/json

{"body":" "}

### Content does not exist (404, CONTENT_NOT_FOUND)
POST {{baseUrl}}/api/contents/999999999/comments
Content-Type: application/json

{"userId":{{userId}},"body":"Missing content"}

### Author does not exist (404, USER_NOT_FOUND)
POST {{baseUrl}}/api/contents/{{contentId}}/comments
Content-Type: application/json

{"userId":999999999,"body":"Missing user"}

### Comment does not exist (404, COMMENT_NOT_FOUND)
GET {{baseUrl}}/api/comments/999999999

### Delete comment (204)
DELETE {{baseUrl}}/api/comments/{{commentId}}
